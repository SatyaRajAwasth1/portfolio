---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../site.config";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
}

const { title, description = site.description, image, type = "website" } = Astro.props;

// Generated social preview from src/pages/og, matched to this page's path; other pages use the default card.
const pagePath = Astro.url.pathname.replace(/^\/|\/$/g, "");
const ogPath = /^(writing|projects)(\/[^/]+)?$|^(research|about)$/.test(pagePath) ? pagePath : "default";
const ogImage = image ?? `/og/${ogPath}.png`;
const fullTitle = title && title !== site.name ? `${title} | ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={site.avatar} />
    <link rel="alternate" type="application/rss+xml" title={`${site.name}: Writing`} href="/rss.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? site.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site ?? site.url)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? site.name} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site ?? site.url)} />

    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1115" media="(prefers-color-scheme: dark)" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
    />

    <!-- Sets the theme before first paint so pages never flash the wrong colors. -->
    <script is:inline>
      (function () {
        var pref = "auto";
        try { pref = localStorage.getItem("theme") || "auto"; } catch (e) {}
        var media = window.matchMedia("(prefers-color-scheme: dark)");
        function apply() {
          var resolved = pref === "light" || pref === "dark" ? pref : media.matches ? "dark" : "light";
          document.documentElement.dataset.theme = resolved;
          document.documentElement.dataset.themePref = pref;
        }
        apply();
        media.addEventListener("change", function () { if (pref === "auto") apply(); });
        window.__setTheme = function (next) {
          pref = next;
          try { localStorage.setItem("theme", next); } catch (e) {}
          apply();
        };
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <Header />
    <main class="mx-auto max-w-[68rem] px-5 sm:px-6">
      <slot />
    </main>
    <Footer />
  </body>
</html>
