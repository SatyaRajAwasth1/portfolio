---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { components } from "../../components/post/post-mdx-components";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { getProjects, formatDate, tagSlug } from "../../lib/content";
import { PROJECT_TYPES } from "../../lib/taxonomy";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await project.render();
const { title, summary, area, date, role, stack, links, tags, type } = project.data;

const linkList = [
  links.paper && { label: "Paper", href: links.paper },
  links.demo && { label: "Demo", href: links.demo },
].filter(Boolean) as { label: string; href: string }[];

const facts = [
  { label: "Date", value: formatDate(date, "month") },
  role && { label: "Role", value: role },
  stack.length > 0 && { label: "Stack", value: stack.join(", ") },
].filter(Boolean) as { label: string; value: string }[];
---

<BaseLayout title={title} description={summary} type="article">
  <article class="max-w-[44rem] pt-10 pb-4 sm:pt-14">
    <header>
      <Breadcrumbs items={[{ label: "Projects", href: "/projects" }, { label: PROJECT_TYPES[type].label }]} />

      <h1 class="mt-6 text-[2rem] leading-[1.15] font-semibold tracking-[-0.025em] sm:text-[2.5rem]">{title}</h1>
      <p class="mt-3 text-lg leading-relaxed text-ink-2 text-pretty">{summary}</p>

      <p class="mt-4 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm">
        <span class="font-medium text-accent">{PROJECT_TYPES[type].label}</span>
        <span class="text-ink-3/60" aria-hidden="true">/</span>
        <span class="text-ink-2">{area}</span>
        {tags.length > 0 && <span class="text-ink-3/60" aria-hidden="true">/</span>}
        {tags.map((tag) => <a href={`/tags/${tagSlug(tag)}`} class="text-ink-3 transition-colors hover:text-ink">#{tag}</a>)}
      </p>

      <div class="mt-6 border-b border-rule pb-6">
        <dl class="grid gap-x-6 gap-y-1.5 text-sm sm:grid-cols-[4.5rem_minmax(0,1fr)]">
          {facts.map((f) => (
            <>
              <dt class="text-ink-3">{f.label}</dt>
              <dd class="text-ink-2">{f.value}</dd>
            </>
          ))}
          <dt class="text-ink-3">Source</dt>
          <dd>
            {
              links.repo ? (
                <a class="link inline-flex items-center gap-1.5" href={links.repo} target="_blank" rel="noopener">
                  <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" /><path d="M9 18c-4.51 2-5-2-7-2" /></svg>
                  {links.repo.replace(/^https?:\/\/(www\.)?/, "")}
                </a>
              ) : (
                <a href="#" class="cursor-not-allowed text-ink-3" aria-disabled="true" title="Source code is not public yet" data-no-source>
                  Not public yet
                </a>
              )
            }
          </dd>
          {linkList.length > 0 && (
            <>
              <dt class="text-ink-3">Links</dt>
              <dd class="flex flex-wrap gap-x-4">
                {linkList.map((l) => <a class="link" href={l.href} target="_blank" rel="noopener">{l.label}</a>)}
              </dd>
            </>
          )}
        </dl>
      </div>
    </header>

    <div class="prose prose-post mt-10">
      <Content components={components} />
    </div>

    <p class="mt-14 border-t border-rule pt-6">
      <a href="/projects" class="link text-sm">All projects</a>
    </p>
  </article>
</BaseLayout>

<script>
  // The placeholder source link keeps its "#" but should not jump to the top of the page.
  document.querySelectorAll("[data-no-source]").forEach((a) => a.addEventListener("click", (e) => e.preventDefault()));
</script>
