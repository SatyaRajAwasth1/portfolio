---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import ProjectList from "../../components/ProjectList.astro";
import { getProjects } from "../../lib/content";
import { site } from "../../site.config";

const projects = await getProjects();
const github = site.socials.find((s) => s.icon === "github");
---

<BaseLayout title="Projects" description="Projects and prototypes I have built while exploring, experimenting, and learning.">
  <div class="pt-10 pb-4 sm:pt-14">
    <Breadcrumbs items={[{ label: "Projects" }]} />

    <header class="mt-6">
      <h1 class="flex items-baseline gap-3 text-3xl font-semibold tracking-[-0.025em]">
        Projects <span class="text-lg font-normal text-ink-3 tabular-nums">{projects.length}</span>
      </h1>
      <div class="mt-3 grid max-w-[42rem] gap-3 text-[1.0625rem] leading-relaxed text-ink-2">
        <p>
          I learn by building. Alongside my work and studies, I keep exploring, experimenting, and
          building projects and prototypes in the areas I work in, research, or want to understand
          better.
        </p>
        <p>A few of them are listed here, each with a short write-up. The rest live on GitHub.</p>
      </div>
      {
        github && (
          <a
            href={github.href}
            target="_blank"
            rel="noopener"
            class="mt-5 inline-flex items-center gap-2 rounded-md border border-rule px-3.5 py-2 text-sm font-medium text-ink transition-colors hover:bg-paper-2"
          >
            <svg class="size-4 text-ink-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" /><path d="M9 18c-4.51 2-5-2-7-2" /></svg>
            See all projects on GitHub
          </a>
        )
      }
    </header>

    <div class="mt-12">
      <ProjectList projects={projects} />
    </div>

    {
      github && (
        <p class="mt-8 text-[0.9375rem] text-ink-2">
          Looking for more? Experiments, prototypes, and open-source contributions are on
          <a class="link" href={github.href} target="_blank" rel="noopener">GitHub</a>.
        </p>
      )
    }
  </div>
</BaseLayout>
