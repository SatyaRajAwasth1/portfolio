---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
---

<BaseLayout title="Search" description="Search writing and projects.">
  <div class="pt-10 pb-4 sm:pt-14">
    <PageHeader breadcrumbs={[{ label: "Search" }]} title="Search" />

    <form class="mt-6 max-w-[44rem]" role="search" id="search-form">
      <label for="search-input" class="sr-only">Search writing and projects</label>
      <div class="relative">
        <svg class="pointer-events-none absolute top-1/2 left-3.5 size-4 -translate-y-1/2 text-ink-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
        <input
          id="search-input"
          type="search"
          autocomplete="off"
          placeholder="Search writing and projects"
          class="w-full rounded-lg border border-rule bg-paper py-2.5 pr-4 pl-10 text-ink placeholder:text-ink-3 focus:border-ink-3 focus:outline-none"
        />
      </div>
    </form>

    <p id="search-status" class="mt-4 text-sm text-ink-3" aria-live="polite"></p>
    <ul id="search-results" class="mt-4 grid max-w-[46rem] divide-y divide-rule"></ul>
  </div>
</BaseLayout>

<script>
  type Result = { url: string; excerpt: string; meta: { title?: string; type?: string } };
  type Pagefind = {
    search: (q: string) => Promise<{ results: { data: () => Promise<Result> }[] }>;
  };

  const input = document.getElementById("search-input") as HTMLInputElement;
  const status = document.getElementById("search-status")!;
  const list = document.getElementById("search-results")!;
  document.getElementById("search-form")!.addEventListener("submit", (e) => e.preventDefault());

  let pagefind: Pagefind | null = null;
  async function load(): Promise<Pagefind | null> {
    if (pagefind) return pagefind;
    try {
      // The index is generated by `pagefind` after `astro build`, so it only exists on built sites.
      const path = "/pagefind/pagefind.js";
      pagefind = (await import(/* @vite-ignore */ path)) as Pagefind;
      return pagefind;
    } catch {
      status.textContent = "Search is available on the built site. Run yarn build, then yarn preview.";
      return null;
    }
  }

  const escape = (s: string) =>
    s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);

  let latest = 0;
  async function run(query: string) {
    const id = ++latest;
    const url = new URL(location.href);
    if (query) url.searchParams.set("q", query);
    else url.searchParams.delete("q");
    history.replaceState(null, "", url);

    if (!query.trim()) {
      list.innerHTML = "";
      status.textContent = "";
      return;
    }
    const pf = await load();
    if (!pf || id !== latest) return;
    const search = await pf.search(query);
    const results = await Promise.all(search.results.slice(0, 20).map((r) => r.data()));
    if (id !== latest) return;

    status.textContent = results.length
      ? `${search.results.length} ${search.results.length === 1 ? "result" : "results"} for "${query}"`
      : `No results for "${query}".`;
    // Excerpts come from Pagefind with matches wrapped in <mark>; titles and types are escaped.
    list.innerHTML = results
      .map(
        (r) => `<li class="py-5">
          ${r.meta.type ? `<p class="text-[0.8125rem] font-medium text-accent">${escape(r.meta.type)}</p>` : ""}
          <h2 class="mt-1 text-[1.0625rem] font-medium leading-snug"><a class="text-ink transition-colors hover:text-accent" href="${escape(r.url)}">${escape(r.meta.title ?? r.url)}</a></h2>
          <p class="search-excerpt mt-1 text-[0.9375rem] text-ink-2">${r.excerpt}</p>
        </li>`,
      )
      .join("");
  }

  let timer: number | undefined;
  input.addEventListener("input", () => {
    clearTimeout(timer);
    timer = window.setTimeout(() => run(input.value), 150);
  });

  const initial = new URLSearchParams(location.search).get("q");
  if (initial) {
    input.value = initial;
    run(initial);
  }
  input.focus();
</script>

<style is:global>
  .search-excerpt mark {
    background: var(--accent-soft);
    color: var(--ink);
    border-radius: 2px;
    padding: 0 1px;
  }
</style>
