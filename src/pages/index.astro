---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import PostList from "../components/PostList.astro";
import ProjectList from "../components/ProjectList.astro";
import { getPosts, getProjects, pickFeatured } from "../lib/content";

const posts = pickFeatured(await getPosts(), 5);
// This section can later be switched to papers or publications.
const projects = pickFeatured(await getProjects(), 3);

---

<BaseLayout>
  <div class="grid gap-20 pt-14 pb-4 sm:pt-20">
    <Hero />

    <Section title="Writing" more={{ label: "All writing", href: "/writing" }}>
      <PostList posts={posts} />
    </Section>

    {
      projects.length > 0 && (
        <Section title="Projects" more={{ label: "All projects", href: "/projects" }}>
          <ProjectList projects={projects} />
        </Section>
      )
    }
  </div>
</BaseLayout>
