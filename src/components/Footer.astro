---
import { site } from "../site.config";

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-rule">
  <div class="mx-auto flex max-w-[68rem] flex-col gap-4 px-5 py-8 text-sm text-ink-3 sm:flex-row sm:items-center sm:justify-between sm:px-6">
    <p>Copyright {year} {site.name}</p>
    <ul class="flex flex-wrap gap-x-5 gap-y-1">
      <li><a class="hover:text-ink" href={`mailto:${site.email}`}>Email</a></li>
      {
        site.socials.map(({ label, href }) => (
          <li>
            <a class="hover:text-ink" href={href} target="_blank" rel="noopener noreferrer">{label}</a>
          </li>
        ))
      }
      <li><a class="hover:text-ink" href="/log">Log</a></li>
      <li><a class="hover:text-ink" href="/now">Now</a></li>
    </ul>
  </div>
</footer>
