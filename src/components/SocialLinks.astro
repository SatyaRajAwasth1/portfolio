---
// Buttons with an outline icon and a name, e.g. [icon] LinkedIn. Profiles come from `socials` in site.config.ts.
import { site } from "../site.config";

interface Props {
  // Which links to show, by icon name. Defaults to GitHub, LinkedIn, and Email.
  only?: string[];
}

const { only = ["github", "linkedin", "email"] } = Astro.props;

const icons: Record<string, string> = {
  github:
    '<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/>',
  linkedin:
    '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/>',
  x: '<path d="M4 4l6.6 8.8L4.3 20H6l5.4-6.1L16 20h4l-6.9-9.2L19 4h-1.7l-5 5.7L8 4z"/>',
  youtube:
    '<path d="M2.5 17a24.1 24.1 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.6 49.6 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.1 24.1 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.6 49.6 0 0 1-16.2 0A2 2 0 0 1 2.5 17"/><path d="m10 15 5-3-5-3z"/>',
  email: '<rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>',
};

const links = [
  ...site.socials.map((s) => ({ label: s.label, href: s.href, icon: s.icon as string, external: true })),
  { label: "Email", href: `mailto:${site.email}`, icon: "email", external: false },
].filter((link) => only.includes(link.icon));
---

<ul class="flex flex-wrap items-center gap-2" aria-label="Elsewhere">
  {
    links.map((link) => (
      <li>
        <a
          href={link.href}
          class="inline-flex items-center gap-2 rounded-md border border-rule px-3.5 py-2 font-medium text-ink transition-colors hover:bg-paper-2"
          {...(link.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
        >
          <svg
            class="size-4 text-ink-2"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            set:html={icons[link.icon]}
          />
          {link.label}
        </a>
      </li>
    ))
  }
</ul>
