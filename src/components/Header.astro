---
import { site } from "../site.config";

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="sticky top-0 z-40 border-b border-rule bg-paper/85 backdrop-blur-md">
  <div class="mx-auto flex max-w-[68rem] flex-wrap items-center gap-x-6 gap-y-1 px-5 py-3 sm:px-6">
    <a href="/" class="mr-auto text-[0.9375rem] font-semibold tracking-[-0.01em] text-ink">{site.name}</a>
    <nav aria-label="Main" class="order-3 -mx-2 flex w-full gap-1 text-sm sm:order-none sm:mx-0 sm:w-auto">
      {
        site.nav.map(({ label, href }) => (
          <a
            href={href}
            aria-current={isActive(href) ? "page" : undefined}
            class="rounded-md px-2 py-1 text-ink-2 transition-colors hover:bg-paper-2 hover:text-ink aria-[current=page]:font-medium aria-[current=page]:text-ink"
          >
            {label}
          </a>
        ))
      }
    </nav>
    <button
      id="theme-toggle"
      type="button"
      class="grid size-8 cursor-pointer place-items-center rounded-md text-ink-2 transition-colors hover:bg-paper-2 hover:text-ink"
      aria-label="Change color theme"
      title="Theme: auto"
    >
      <!-- Shows the current preference: auto, light or dark. -->
      <svg data-icon="auto" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="8.5" /><path d="M12 3.5v17" /><path d="M12 3.5a8.5 8.5 0 0 1 0 17z" fill="currentColor" /></svg>
      <svg data-icon="light" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4" /></svg>
      <svg data-icon="dark" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" /></svg>
    </button>
  </div>
</header>

<style>
  #theme-toggle svg {
    display: none;
  }
  :global(html[data-theme-pref="auto"]) #theme-toggle [data-icon="auto"],
  :global(html:not([data-theme-pref])) #theme-toggle [data-icon="auto"],
  :global(html[data-theme-pref="light"]) #theme-toggle [data-icon="light"],
  :global(html[data-theme-pref="dark"]) #theme-toggle [data-icon="dark"] {
    display: block;
  }
</style>

<script is:inline>
  (function () {
    var btn = document.getElementById("theme-toggle");
    if (!btn) return;
    var order = ["auto", "light", "dark"];
    function sync() {
      var pref = document.documentElement.dataset.themePref || "auto";
      btn.title = "Theme: " + pref;
      btn.setAttribute("aria-label", "Color theme: " + pref + ". Click to change.");
    }
    sync();
    btn.addEventListener("click", function () {
      var cur = document.documentElement.dataset.themePref || "auto";
      window.__setTheme(order[(order.indexOf(cur) + 1) % order.length]);
      sync();
    });
  })();
</script>
