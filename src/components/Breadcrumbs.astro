---
// Home / Writing / Deep Dives. Items without an href (the current page) are not links.
interface Props {
  items: { label: string; href?: string }[];
}

const { items } = Astro.props;
const trail = [{ label: "Home", href: "/" }, ...items];
---

<nav aria-label="Breadcrumb">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-ink-3">
    {
      trail.map((item, i) => (
        <li class="flex items-center gap-2">
          {i > 0 && <span class="text-ink-3/60" aria-hidden="true">/</span>}
          {item.href ? (
            <a href={item.href} class="transition-colors hover:text-ink">{item.label}</a>
          ) : (
            <span class="text-ink-2" aria-current="page">{item.label}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
