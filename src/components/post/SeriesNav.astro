---
import Icon from "../Icon.astro";

const { prev, next } = Astro.props;
---

<nav class="mt-10 grid gap-3 sm:grid-cols-2" aria-label="Series navigation">
  {
    prev ? (
      <a href={`/writing/${prev.slug}`} class="group rounded-lg border border-rule p-4 transition-colors hover:border-ink-3">
        <span class="inline-flex items-center gap-1 text-xs text-ink-3"><Icon name="arrow-left" />Previous part</span>
        <span class="mt-1 block font-medium leading-snug group-hover:text-accent">{prev.data.title}</span>
      </a>
    ) : (
      <span class="hidden sm:block" />
    )
  }
  {
    next && (
      <a href={`/writing/${next.slug}`} class="group rounded-lg border border-rule p-4 text-right transition-colors hover:border-ink-3">
        <span class="inline-flex items-center gap-1 text-xs text-ink-3">Next part<Icon name="arrow-right" /></span>
        <span class="mt-1 block font-medium leading-snug group-hover:text-accent">{next.data.title}</span>
      </a>
    )
  }
</nav>
