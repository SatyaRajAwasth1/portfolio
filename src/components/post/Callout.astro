---
type CalloutType = "info" | "warning" | "error" | "success";
const { type = "info", title } = Astro.props as { type?: CalloutType; title?: string };

const tone = {
  info: "border-accent",
  warning: "border-warn",
  error: "border-danger",
  success: "border-ok",
};
const labels = { info: "Note", warning: "Warning", error: "Caution", success: "Tip" };
---

<aside
  class={`not-prose my-7 border-l-2 ${tone[type] ?? tone.info} bg-paper-2 px-4 py-3.5 font-sans`}
  aria-label={title || labels[type]}
>
  <p class="eyebrow mb-1.5">{title || labels[type]}</p>
  <div class="text-[0.9375rem] leading-relaxed text-ink [&_a]:text-accent [&_a]:underline [&_a]:underline-offset-2 [&_p+p]:mt-2">
    <slot />
  </div>
</aside>
