---
const { author, source } = Astro.props as { author?: string; source?: string };
---

<figure class="not-prose my-8 border-l-2 border-ink pl-5">
  <blockquote class="font-serif text-[1.3125rem] leading-snug text-ink italic">
    <slot />
  </blockquote>
  {
    author && (
      <figcaption class="mt-2.5 font-mono text-xs text-ink-3">
        {author}
        {source && <span>, {source}</span>}
      </figcaption>
    )
  }
</figure>
